<odoo>
    <!-- Tree view de hijos solo lectura -->
    <record id="view_affiliate_child_tree_readonly" model="ir.ui.view">
        <field name="name">affiliation.affiliate_child.tree.readonly</field>
        <field name="model">affiliation.affiliate_child</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <tree class="o_sticky_list">
                <field name="name"/>
                <field name="age"/>
                <field name="personal_id"/>
                <field name="birth_date"/>
                <field name="handicapped"/>
                <field name="verified"/>
                <field name="educational_level"/>
                <field name="observation"/>
                <field name="affiliate_names"/>
            </tree>
        </field>
    </record>

    <!-- Form view de hijos solo lectura -->
    <record id="view_affiliate_child_form_readonly" model="ir.ui.view">
        <field name="name">affiliation.affiliate_child.form.readonly</field>
        <field name="model">affiliation.affiliate_child</field>
        <field name="priority" eval="100"/>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="personal_id"/>
                        <field name="birth_date"/>
                        <field name="handicapped"/>
                        <field name="verified"/>
                        <field name="educational_level"/>
                        <field name="affiliate_names"/>
                        <field name="observation"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

  <record id="action_affiliation_affiliates_childs" model="ir.actions.act_window">
    <field name="name">Affiliate's Childs</field>
    <field name="res_model">affiliation.affiliate_child</field>
    <field name="view_mode">tree</field>
    <field name="view_id" ref="view_affiliate_child_tree_readonly"/>
  </record>

  <menuitem id="menu_affiliation_affiliates_childs" name="Affiliate's Childs"
            parent="union_affiliation.affiliates_section"
            action="action_affiliation_affiliates_childs"
            groups="union_affiliation.group_affiliation_read"/>
</odoo>

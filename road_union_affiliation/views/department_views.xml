<odoo>
  <record id="view_department_form" model="ir.ui.view">
    <field name="name">affiliation.department.form</field>
    <field name="model">affiliation.department</field>
    <field name="arch" type="xml">
      <form string="Department">
        <sheet>
          <group>
            <field name="name"/>
            <field name="code"/>
            <field name="active"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_department_tree" model="ir.ui.view">
    <field name="name">affiliation.department.tree</field>
    <field name="model">affiliation.department</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="code"/>
        <field name="active"/>
      </tree>
    </field>
  </record>

  <record id="action_affiliation_department" model="ir.actions.act_window">
    <field name="name">Road Departments</field>
    <field name="res_model">affiliation.department</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="menu_affiliation_department_root" name="Road Departments"
            parent="union_affiliation.affiliates_section"
            action="action_affiliation_department"
            groups="union_affiliation.group_affiliation_read"/>
</odoo>

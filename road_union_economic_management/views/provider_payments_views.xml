<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- ==================== VISTAS DE PROVEEDORES ==================== -->
    
    <record id="view_sindicato_proveedor_tree" model="ir.ui.view">
        <field name="name">sindicato.proveedor.tree</field>
        <field name="model">sindicato.proveedor</field>
        <field name="arch" type="xml">
            <tree string="Proveedores del Sindicato">
                <field name="nombre"/>
                <field name="tipo"/>
                <field name="porcentaje_comision"/>
                <field name="activo"/>
            </tree>
        </field>
    </record>

    <record id="view_sindicato_proveedor_form" model="ir.ui.view">
        <field name="name">sindicato.proveedor.form</field>
        <field name="model">sindicato.proveedor</field>
        <field name="arch" type="xml">
            <form string="Proveedor del Sindicato">
                <sheet>
                    <group>
                        <group>
                            <field name="nombre"/>
                            <field name="tipo"/>
                        </group>
                        <group>
                            <field name="porcentaje_comision"/>
                            <field name="activo"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historial de Importes">
                            <field name="importe_ids">
                                <tree>
                                    <field name="mes"/>
                                    <field name="anio"/>
                                    <field name="importe_total_plan"/>
                                    <field name="comision"/>
                                    <field name="importe_a_pagar"/>
                                    <field name="cuarenta_porciento_farmacias"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== VISTAS DE LIQUIDACIÓN MENSUAL ==================== -->
    
    <record id="view_sindicato_liquidacion_mensual_tree" model="ir.ui.view">
        <field name="name">sindicato.liquidacion.mensual.tree</field>
        <field name="model">sindicato.liquidacion.mensual</field>
        <field name="arch" type="xml">
            <tree string="Liquidaciones Mensuales">
                <field name="descripcion"/>
                <field name="mes"/>
                <field name="anio"/>
                <field name="total_importe_plan"/>
                <field name="total_comision"/>
                <field name="total_importe_pagar"/>
            </tree>
        </field>
    </record>

    <record id="view_sindicato_liquidacion_mensual_form" model="ir.ui.view">
        <field name="name">sindicato.liquidacion.mensual.form</field>
        <field name="model">sindicato.liquidacion.mensual</field>
        <field name="arch" type="xml">
            <form string="Liquidación Mensual">
                <header>
                    <button name="action_generar_lineas"
                            string="Generar Líneas de Proveedores"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_calcular_farmacias_desde_gastos"
                            string="Calcular Farmacias desde Gastos"
                            type="object"
                            help="Completa importe y 40% de cada farmacia desde los gastos cargados del mes. Los valores quedan editables."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="descripcion" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="mes"/>
                            <field name="anio"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Proveedores">
                            <field name="importe_ids">
                                <tree editable="bottom" create="false" delete="true">
                                    <field name="proveedor_id" readonly="1"/>
                                    <field name="es_farmacia" invisible="1"/>
                                    <field name="porcentaje_comision" readonly="1"/>
                                    <field name="importe_total_plan" sum="Total"/>
                                    <field name="comision" sum="Total" readonly="1" force_save="1"/>
                                    <field name="importe_a_pagar" sum="Total" readonly="1" force_save="1"/>
                                    <field name="cuarenta_porciento_farmacias" 
                                           sum="Total" 
                                           optional="show"
                                           attrs="{'readonly': [('es_farmacia', '=', False)]}"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        
                        <page string="Totales">
                            <group>
                                <group string="Resumen General">
                                    <field name="total_importe_plan" readonly="1"/>
                                    <field name="total_comision" readonly="1"/>
                                    <field name="total_importe_pagar" readonly="1"/>
                                    <field name="total_farmacias" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==================== ACCIONES ==================== -->
    
    <record id="action_sindicato_proveedor" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">sindicato.proveedor</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear un nuevo proveedor
            </p>
        </field>
    </record>

    <record id="action_sindicato_liquidacion_mensual" model="ir.actions.act_window">
        <field name="name">Liquidaciones Mensuales</field>
        <field name="res_model">sindicato.liquidacion.mensual</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una nueva liquidación mensual
            </p>
        </field>
    </record>

    <!-- Acción de servidor para abrir liquidación del mes actual -->
    <record id="action_sindicato_liquidacion_mes_actual" model="ir.actions.server">
        <field name="name">Abrir Liquidación Mes Actual</field>
        <field name="model_id" ref="model_sindicato_liquidacion_mensual"/>
        <field name="state">code</field>
        <field name="code">
liquidacion = model.get_or_create_current_month()
action = {
    'type': 'ir.actions.act_window',
    'res_model': 'sindicato.liquidacion.mensual',
    'view_mode': 'form',
    'res_id': liquidacion.id,
    'target': 'current',
}
        </field>
    </record>

    <!-- ==================== MENÚS ==================== -->
    
    <menuitem id="menu_sindicato_root"
              parent="union_affiliation.union"
              name="Liquidaciones"
              sequence="10"/>

    <menuitem id="menu_sindicato_liquidacion_actual"
              name="Liquidación Mes Actual"
              parent="menu_sindicato_root"
              action="action_sindicato_liquidacion_mes_actual"
              sequence="5"/>

    <menuitem id="menu_sindicato_liquidaciones"
              name="Todas las Liquidaciones"
              parent="menu_sindicato_root"
              action="action_sindicato_liquidacion_mensual"
              sequence="8"/>

    <menuitem id="menu_sindicato_proveedores"
              name="Proveedores"
              parent="menu_sindicato_root"
              action="action_sindicato_proveedor"
              sequence="10"/>

</odoo>
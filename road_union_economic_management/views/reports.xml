<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- REPORTE PDF -->
    <record id="action_report_affiliate_payment" model="ir.actions.report">
        <field name="name">Resumen Económico Mensual</field>
        <field name="model">affiliate.payment_account</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">road_union_economic_management.report_affiliate_payment_account_document</field>
        <field name="report_file">road_union_economic_management.report_affiliate_payment_account_document</field>
        <field name="binding_model_id" ref="model_affiliate_payment_account"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- TEMPLATE QWEB CON CODIFICACIÓN CORREGIDA -->
    <template id="report_affiliate_payment_account_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="data_report_margin_top" t-value="12"/>
                <t t-set="data_report_header_spacing" t-value="9"/>
                
                <!-- Definir variables globales con caracteres especiales -->
                <t t-set="month_names" t-value="{
                    '01': 'Enero', '02': 'Febrero', '03': 'Marzo', '04': 'Abril',
                    '05': 'Mayo', '06': 'Junio', '07': 'Julio', '08': 'Agosto',
                    '09': 'Septiembre', '10': 'Octubre', '11': 'Noviembre', '12': 'Diciembre'
                }"/>
                
                <div class="header o_clean_header">
                    <!-- Meta tags para codificación -->
                    <meta charset="utf-8"/>
                    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1"/>
                </div>
                
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <!-- Header Principal -->
                        <div class="header" style="border-bottom: 2px solid #875A7B; margin-bottom: 25px; padding-bottom: 15px;">
                            <div class="row">
                                <div class="col-8">
                                    <h2 style="color: #875A7B; margin: 0; font-size: 22px;">Resumen Económico Mensual</h2>
                                    <h3 style="margin: 8px 0 0 0; font-size: 18px;">
                                        <t t-esc="month_names.get(doc.date_month, doc.date_month)"/> 
                                        <t t-esc="doc.date_year"/>
                                    </h3>
                                </div>
                                <div class="col-4 text-right">
                                    <p style="margin: 0; font-size: 14px;">
                                        <strong>Estado:</strong> 
                                        <t t-if="doc.state == 'confirmed'">
                                            <span style="color: green; font-size: 14px;">✓ Confirmado</span>
                                        </t>
                                        <t t-else="">
                                            <span style="color: orange; font-size: 14px;">⚠ Borrador</span>
                                        </t>
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Información del Afiliado -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <table class="table table-bordered" style="margin-bottom: 20px; font-size: 14px; width: 100%; margin-left: auto; margin-right: auto;">
                                    <thead style="background-color: #f8f9fa;">
                                        <tr>
                                            <th colspan="4" style="text-align: center; background-color: #875A7B; color: white; padding: 12px; font-size: 16px;">
                                                INFORMACIÓN DEL AFILIADO
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td style="padding: 10px; font-weight: bold; width: 15%;">Nombre:</td>
                                            <td style="padding: 10px; width: 35%;"><t t-esc="doc.affiliate_name"/></td>
                                            <td style="padding: 10px; font-weight: bold; width: 15%;">Nº Afiliado:</td>
                                            <td style="padding: 10px; width: 35%;"><t t-esc="doc.affiliate_number"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 10px; font-weight: bold;">DNI:</td>
                                            <td style="padding: 10px;"><t t-esc="doc.dni"/></td>
                                            <td style="padding: 10px; font-weight: bold;">Tipo:</td>
                                            <td style="padding: 10px;"><t t-esc="doc.affiliate_type"/></td>
                                        </tr>
                                        <tr>
                                            <td style="padding: 10px; font-weight: bold;">Clase:</td>
                                            <td style="padding: 10px;"><t t-esc="doc.affiliate_class"/></td>
                                            <td style="padding: 10px; font-weight: bold;">ID/BENEFIT:</td>
                                            <td style="padding: 10px;"><t t-esc="doc.id_benefit"/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Resumen Económico -->
                        <div class="row">
                            <div class="col-12">
                                <table class="table table-bordered" style="font-size: 14px; width: 100%; margin: 0 auto;">
                                    <thead style="background-color: #f8f9fa;">
                                        <tr>
                                            <th colspan="2" style="text-align: center; background-color: #875A7B; color: white; padding: 12px; font-size: 16px;">
                                                RESUMEN ECONÓMICO
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Saldo Inicial -->
                                        <tr style="background-color: #e3f2fd;">
                                            <td style="padding: 8px; font-size: 14px;"><strong>SALDO INICIAL</strong></td>
                                            <td style="width: 200px; text-align: right; padding: 8px; font-size: 14px;">
                                                <t t-esc="'${:,.2f}'.format(doc.initial_balance or 0)"/>
                                            </td>
                                        </tr>

                                        <!-- Servicios -->
                                        <tr style="background-color: #fff3e0;">
                                            <td colspan="2" style="padding: 8px; font-size: 14px;"><strong>SERVICIOS</strong></td>
                                        </tr>
                                        <t t-if="doc.pharmacy_total">
                                            <tr>
                                                <td style="padding: 6px 8px;">Todas las farmacias</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.pharmacy_total or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.optical_total">
                                            <tr>
                                                <td style="padding: 6px 8px;">Óptica</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.optical_total or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.punilla_total">
                                            <tr>
                                                <td style="padding: 6px 8px;">Punilla</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.punilla_total or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.solar_caruso">
                                            <tr>
                                                <td style="padding: 6px 8px;">Solar Caruso</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.solar_caruso or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.parque_del_sol">
                                            <tr>
                                                <td style="padding: 6px 8px;">Parque del Sol</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.parque_del_sol or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.salguero">
                                            <tr>
                                                <td style="padding: 6px 8px;">Salguero</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.salguero or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.tres_provincias">
                                            <tr>
                                                <td style="padding: 6px 8px;">Tres Provincias</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.tres_provincias or 0)"/>
                                                </td>
                                            </tr>
                                        </t>

                                        <!-- Préstamos -->
                                        <tr style="background-color: #ffebee;">
                                            <td colspan="2" style="padding: 8px; font-size: 14px;"><strong>PRÉSTAMOS</strong></td>
                                        </tr>
                                        <t t-if="doc.ecco_loan">
                                            <tr>
                                                <td style="padding: 6px 8px;">Ecco (Pasado como Préstamo)</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.ecco_loan or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.emi_loan">
                                            <tr>
                                                <td style="padding: 6px 8px;">Emi (Pasado como Préstamo)</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.emi_loan or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.emergency_loan">
                                            <tr>
                                                <td style="padding: 6px 8px;">Urgencias (Pasado como Préstamo)</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.emergency_loan or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.suoem_loan">
                                            <tr>
                                                <td style="padding: 6px 8px;">Suoem (Pasado como Préstamo)</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.suoem_loan or 0)"/>
                                                </td>
                                            </tr>
                                        </t>

                                        <!-- Otros Servicios -->
                                        <tr style="background-color: #e8f5e8;">
                                            <td colspan="2" style="padding: 8px; font-size: 14px;"><strong>OTROS SERVICIOS</strong></td>
                                        </tr>
                                        <t t-if="doc.tourism_total">
                                            <tr>
                                                <td style="padding: 6px 8px;">Turismo</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.tourism_total or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.aid_total">
                                            <tr>
                                                <td style="padding: 6px 8px;">Ayudas</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.aid_total or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.party_total">
                                            <tr>
                                                <td style="padding: 6px 8px;">Fiesta</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.party_total or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.hall_total">
                                            <tr>
                                                <td style="padding: 6px 8px;">Salón</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.hall_total or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.odontology_total">
                                            <tr>
                                                <td style="padding: 6px 8px;">Otros</td>
                                                <td style="text-align: right; padding: 6px 8px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.odontology_total or 0)"/>
                                                </td>
                                            </tr>
                                        </t>

                                        <!-- Subtotal Servicios -->
                                        <tr style="background-color: #f5f5f5; font-weight: bold;">
                                            <td style="padding: 8px; font-size: 14px;">TOTAL SERVICIOS</td>
                                            <td style="text-align: right; padding: 8px; font-size: 14px;">
                                                <t t-esc="'${:,.2f}'.format(doc.total_services or 0)"/>
                                            </td>
                                        </tr>

                                        <!-- Cuota Sindical -->
                                        <t t-if="doc.union_fee">
                                            <tr>
                                                <td style="padding: 8px; font-size: 14px;"><strong>CUOTA SINDICAL</strong></td>
                                                <td style="text-align: right; padding: 8px; font-size: 14px;">
                                                    <t t-esc="'${:,.2f}'.format(doc.union_fee or 0)"/>
                                                </td>
                                            </tr>
                                        </t>

                                        <!-- Total -->
                                        <tr style="background-color: #875A7B; color: white; font-weight: bold; font-size: 16px;">
                                            <td style="padding: 10px;">TOTAL</td>
                                            <td style="text-align: right; padding: 10px;">
                                                <t t-esc="'${:,.2f}'.format(doc.total or 0)"/>
                                            </td>
                                        </tr>

                                        <!-- Deducciones -->
                                        <tr style="background-color: #ffcdd2;">
                                            <td colspan="2" style="padding: 8px; font-size: 14px;"><strong>DEDUCCIONES</strong></td>
                                        </tr>
                                        <t t-if="doc.payments">
                                            <tr>
                                                <td style="padding: 6px 8px;">Pagos</td>
                                                <td style="text-align: right; color: red; padding: 6px 8px;">
                                                    <t t-esc="'-${:,.2f}'.format(doc.payments or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.pension_fund">
                                            <tr>
                                                <td style="padding: 6px 8px;">Caja Jub</td>
                                                <td style="text-align: right; color: red; padding: 6px 8px;">
                                                    <t t-esc="'-${:,.2f}'.format(doc.pension_fund or 0)"/>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-if="doc.meta4">
                                            <tr>
                                                <td style="padding: 6px 8px;">Meta 4</td>
                                                <td style="text-align: right; color: red; padding: 6px 8px;">
                                                    <t t-esc="'-${:,.2f}'.format(doc.meta4 or 0)"/>
                                                </td>
                                            </tr>
                                        </t>

                                        <!-- Saldo Final -->
                                        <tr style="background-color: #2e7d32; color: white; font-weight: bold; font-size: 18px;">
                                            <td style="padding: 12px;">SALDO FINAL</td>
                                            <td style="text-align: right; padding: 12px;">
                                                <t t-esc="'${:,.2f}'.format(doc.final_balance or 0)"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Footer -->
                        <div class="row mt-4">
                            <div class="col-12" style="border-top: 1px solid #ddd; padding-top: 15px; font-size: 13px; color: #666; text-align: center;">
                                <p style="margin: 0;">
                                    Documento generado automáticamente el 
                                    <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y a las %H:%M')"/>
                                </p>
                                <p style="margin: 5px 0 0 0;">
                                    <strong>Nota:</strong> Este resumen corresponde al período 
                                    <t t-esc="month_names.get(doc.date_month, doc.date_month)"/> 
                                    <t t-esc="doc.date_year"/>
                                </p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- PLANTILLA DE EMAIL (SINTAXIS CORRECTA PARA MAIL TEMPLATES) -->
    <record id="email_template_affiliate_payment" model="mail.template">
        <field name="name">Resumen Económico - Email</field>
        <field name="model_id" ref="model_affiliate_payment_account"/>
        <field name="subject">Resumen Económico Mensual - {{object.affiliate_name}}</field>
        <field name="body_html"><![CDATA[
            <div style="margin: 0px; padding: 0px;">
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Estimado/a <span t-field="object.affiliate_name"/>,</p>
                
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Su resumen económico mensual ha sido <strong style="box-sizing:border-box;font-weight:bolder;">confirmado</strong> exitosamente.</p>
                
                <div style="background-color: #f8f9fa; padding: 15px; margin: 15px 0; border-left: 4px solid #875A7B;">
                    <h4 style="box-sizing:border-box;font-size:15.6px;line-height:1.2;font-weight:500;font-family:'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, 'Liberation Sans', Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';color: #875A7B; margin: 0 0 10px 0;">Detalles del Resumen:</h4>
                    <ul style="padding:0 0 0 20px;box-sizing:border-box;margin: 0; padding-left: 20px;">
                        <li><strong style="box-sizing:border-box;font-weight:bolder;">Período:</strong> 
                            <t t-set="month_names" t-value="{
                                '01': 'Enero', '02': 'Febrero', '03': 'Marzo', '04': 'Abril',
                                '05': 'Mayo', '06': 'Junio', '07': 'Julio', '08': 'Agosto',
                                '09': 'Septiembre', '10': 'Octubre', '11': 'Noviembre', '12': 'Diciembre'
                            }"/>
                            <span t-esc="month_names.get(object.date_month, object.date_month)"/> 
                            <span t-field="object.date_year"/>
                        </li>
                        <li><strong style="box-sizing:border-box;font-weight:bolder;">Nº Afiliado:</strong> <span t-field="object.affiliate_number"/></li>
                        <li><strong style="box-sizing:border-box;font-weight:bolder;">Saldo Final:</strong> $<span t-esc="'{:,.2f}'.format(object.final_balance or 0)"/></li>
                    </ul>
                </div>
                
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Adjunto a este correo encontrará el detalle completo de su resumen económico mensual en formato PDF.</p>
                
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Si tiene alguna consulta, no dude en contactarnos.</p>
                
                <p style="margin:0px 0 12px 0;box-sizing:border-box;">Saludos cordiales,<br/>
                <span t-field="user.name"/><br/>
                <span t-field="user.company_id.name"/>
                </p>
            </div>
        ]]></field>
        <field name="email_to">{{object.affiliate_id.email}}</field>
        <field name="auto_delete" eval="True"/>
        <field name="report_template" ref="action_report_affiliate_payment"/>
    </record>

    <record id="automated_action_send_payment_email" model="base.automation">
        <field name="name">Enviar Email Resumen Confirmado</field>
        <field name="model_id" ref="model_affiliate_payment_account"/>
        <field name="state">mail_post</field>
        <field name="active" eval="True"/>
        <field name="trigger">on_write</field>
        <field name="filter_pre_domain">[('state', '=', 'draft')]</field>
        <field name="filter_domain">[('state', '=', 'confirmed')]</field>
        <field name="template_id" ref="email_template_affiliate_payment"/>
    </record>
</odoo>
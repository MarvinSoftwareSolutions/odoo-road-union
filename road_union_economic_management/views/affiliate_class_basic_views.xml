<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista -->
    <record id="view_affiliate_class_basic_tree" model="ir.ui.view">
        <field name="name">affiliate.class.basic.tree</field>
        <field name="model">affiliate.class.basic</field>
        <field name="arch" type="xml">
            <tree string="Básicos por Clase" editable="bottom">
                <field name="class_number"/>
                <field name="class_index"/>
                <field name="basic_amount" widget="monetary" 
                       attrs="{'readonly': [('class_number', '!=', 1)]}"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_affiliate_class_basic_form" model="ir.ui.view">
        <field name="name">affiliate.class.basic.form</field>
        <field name="model">affiliate.class.basic</field>
        <field name="arch" type="xml">
            <form string="Básico por Clase">
                <sheet>
                    <group>
                        <group>
                            <field name="class_number"/>
                            <field name="class_index"/>
                            <field name="basic_amount" widget="monetary" 
                                   attrs="{'readonly': [('class_number', '!=', 1)]}"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook attrs="{'invisible': [('class_number', '!=', 1)]}">
                        <page string="Información">
                            <group>
                                <div class="alert alert-info" role="alert">
                                    <p><strong>Clase Base</strong></p>
                                    <p>Este es el monto base que se usa para calcular todas las demás clases.</p>
                                    <p>Al modificar este valor, todas las demás clases se actualizarán automáticamente multiplicando este monto por su índice correspondiente.</p>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_affiliate_class_basic" model="ir.actions.act_window">
        <field name="name">Básicos por Clase</field>
        <field name="res_model">affiliate.class.basic</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configurar los montos básicos por clase de afiliado
            </p>
            <p>
                Estos valores se usan para calcular automáticamente la cuota sindical.
            </p>
            <p>
                <strong>Nota:</strong> Solo se puede editar el monto de la Clase 1. 
                Los demás montos se calcularán automáticamente multiplicando 
                el valor de la Clase 1 por el índice correspondiente.
            </p>
        </field>
    </record>

    <!-- Menú -->
    <menuitem id="menu_affiliate_class_basic"
              name="Básicos por Clase"
              parent="union_affiliation.affiliates_section"
              action="action_affiliate_class_basic"
              sequence="10"/>
</odoo>
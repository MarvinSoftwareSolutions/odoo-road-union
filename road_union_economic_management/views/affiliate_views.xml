<odoo>
  <data>
    <record id="odoo_road_union_economic_management_affiliate_form_inherit" model="ir.ui.view">
      <field name="name">affiliation.affiliate.form.inherit.economic</field>
      <field name="model">affiliation.affiliate</field>
      <field name="inherit_id" ref="road_union_affiliation.odoo_road_union_affiliate_form_inherit"/>
      <field name="arch" type="xml">
        <!-- Insertar el campo 'category' justo después del campo 'affiliate_type_id' -->
        <xpath expr="//notebook" position="inside">
            <page string="Payment account" name="payment_account">
                <field name="payment_account_ids"/>
            </page>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
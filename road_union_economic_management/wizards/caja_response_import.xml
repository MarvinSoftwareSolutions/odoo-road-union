<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_caja_response_import_wizard_form" model="ir.ui.view">
        <field name="name">caja.response.import.wizard.form</field>
        <field name="model">caja.response.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Respuesta de la Caja de Jubilaciones">
                <field name="state" invisible="1"/>

                <!-- Paso 1: carga -->
                <group attrs="{'invisible': [('state', '!=', 'step1')]}">
                    <group>
                        <field name="file_data" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group>
                        <div colspan="2" class="text-muted">
                            Subí el Excel que descargás de la Caja con lo
                            efectivamente descontado (columnas Período, Código
                            AIL, Beneficio, Nombre, Cuil, Descontado,
                            Solicitado...). El período se deduce del archivo.
                        </div>
                    </group>
                </group>

                <!-- Paso 2: preview -->
                <group attrs="{'invisible': [('state', '!=', 'step2')]}">
                    <group>
                        <field name="date_month" readonly="0"/>
                        <field name="date_year" readonly="0"/>
                        <field name="total_descontado"/>
                    </group>
                    <group>
                        <field name="total_ok"/>
                        <field name="total_sin_cuenta"/>
                        <field name="total_confirmadas"/>
                        <field name="total_no_match"/>
                    </group>
                </group>
                <field name="preview_line_ids" attrs="{'invisible': [('state', '!=', 'step2')]}">
                    <tree create="false" delete="false" editable="bottom"
                          decoration-success="status == 'ok'"
                          decoration-danger="status == 'no_match'"
                          decoration-warning="status in ('sin_cuenta', 'confirmada')">
                        <field name="cuil" readonly="1"/>
                        <field name="nombre_archivo" readonly="1"/>
                        <field name="affiliate_id" readonly="1"/>
                        <field name="descontado" readonly="1" sum="Total"/>
                        <field name="solicitado" readonly="1" sum="Total"/>
                        <field name="diferencia" sum="Total"/>
                        <field name="status" readonly="1"/>
                        <field name="account_id" invisible="1"/>
                    </tree>
                </field>

                <!-- Paso 3: resultado -->
                <group attrs="{'invisible': [('state', '!=', 'step3')]}">
                    <field name="result_message" nolabel="1" readonly="1"/>
                </group>

                <footer>
                    <button name="action_parse_file" string="Analizar Archivo"
                            type="object" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'step1')]}"/>
                    <button name="action_confirm_import" string="Confirmar Importación"
                            type="object" class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'step2')]}"/>
                    <button name="action_back" string="Volver"
                            type="object"
                            attrs="{'invisible': [('state', '!=', 'step2')]}"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_caja_response_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar Respuesta Caja de Jubilaciones</field>
        <field name="res_model">caja.response.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Cuelga de Cuentas de Pago: el import actualiza las cuentas del mes -->
    <menuitem id="menu_caja_response_import"
              name="Importar Respuesta Caja de Jub."
              parent="menu_payment_account_root"
              action="action_caja_response_import_wizard"
              groups="union_affiliation.group_affiliation_write"
              sequence="30"/>
</odoo>
